@page
@model global::CityManager.Pages.CityManager.CreateCityHandlerModel
<h2>Exercício 2 — Handler Parameters</h2>
<form method="post">
    <label for="cityName">Nome da cidade</label>
    <input id="cityName" name="cityName" class="form-control" />
    <button class="btn btn-primary mt-2" type="submit">Enviar</button>
</form>
@if (Model.SubmittedCity is not null)
{
    <p>Cidade recebida: @Model.SubmittedCity</p>
}
