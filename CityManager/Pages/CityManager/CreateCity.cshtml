
@page
@model global::CityManager.CreateCityModel

<h2>Cadastro de Cidades Turísticas</h2>

<form method="post">
    <label asp-for="CityName">Nome da cidade:</label>

    <input asp-for="CityName" class="form-control" />

    <br />

    <button type="submit" class="btn btn-primary">
        Cadastrar Cidade
    </button>
</form>

@if (HttpMethods.IsPost(Request.Method))
{
    <h3>Cidade cadastrada: @Model.CityName</h3>
}