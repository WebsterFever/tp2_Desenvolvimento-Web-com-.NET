@* Exercício 10 *@
@page
@model global::CityManager.Pages.Exercicio10.Exercicio10Model
<h2>Salvar Anotação</h2>
<form method="post">
    <label asp-for="Input.Content">Texto da anotação</label>
    <textarea asp-for="Input.Content" class="form-control" rows="5"></textarea>
    <span asp-validation-for="Input.Content" class="text-danger"></span>
    <button type="submit" class="btn btn-primary mt-2">Salvar</button>
</form>
@if (Model.FileName is not null)
{
    <p>Arquivo salvo! <a href="@Url.Content("~/files/" + Model.FileName)" download>Baixar arquivo</a></p>
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
