@* Exercício 06 *@
@page
@model global::CityManager.Pages.Exercicio06.Exercicio06Model
<h2>Cadastro de Países</h2>
<form method="post">
    <div class="mb-3">
        <label asp-for="Input.CountryName">Nome do país</label>
        <input asp-for="Input.CountryName" class="form-control" />
        <span asp-validation-for="Input.CountryName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.CountryCode">Código ISO (2 letras)</label>
        <input asp-for="Input.CountryCode" class="form-control" />
        <span asp-validation-for="Input.CountryCode" class="text-danger"></span>
    </div>
    <button class="btn btn-primary" type="submit">Cadastrar País</button>
</form>
@if (Model.CreatedCountry is not null)
{
    <p>País cadastrado: @Model.CreatedCountry.CountryName (@Model.CreatedCountry.CountryCode)</p>
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
